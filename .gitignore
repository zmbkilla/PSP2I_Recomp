# PSP2i recompilation project -- local repository.
#
# Nothing proprietary is committed: no game image, no extracted disc content,
# no PSP firmware files, and nothing generated from them. The game needs these
# locally to run; they stay on disk, ignored. See port/HANDOFF.md ("Git").

# ---- the game and everything extracted or derived from it -------------------
game.iso
EBOOT.BIN
# extracted UMD (textures, models, audio, video), firmware fonts, memory stick
GameData/
# C generated from the game's code (derived from the EBOOT)
Output/
port/gen/
# disassembly of game code
port/*.dis
# screenshots and captures of the game
port/captures/
*.ppm
# lists of the game's firmware imports (derived from the EBOOT; kept local)
port/imports.txt
port/import_names.txt
port/import_status.txt
port/implemented.txt
# defensive: disc images, PSP containers, firmware fonts, media formats
*.iso
*.cso
*.chd
*.pbp
*.PBP
*.prx
*.PRX
*.pgf
*.PGF
*.at3
*.AT3
*.pmf
*.PMF
*.SFO
*.sfo

# ---- builds and third-party binaries -----------------------------------------
FinalBuild/
port/build/
port/build-*/
build/
*.exe
*.dll
*.pdb
*.ilk
*.obj
*.lib

# ---- logs, temporary files, caches ---------------------------------------------
*.log
*.tmp
*.bak
__pycache__/
*.pyc

# ---- IDE files ---------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.suo
*.user
*.swp

# user test material: game screenshots and run logs
debugscreen/
*_log.txt

# third-party runtime libraries (FFmpeg for ATRAC music), kept local
ffmpeg-*/

# ---- community build output (prod/): binaries and the user's game data stay local
prod/*
!prod/README.txt

# my test artifacts (captures, logs, save copies)
port/testwork/

# ---- notes and write-ups for other people, cheat codes: not source code
party_*.txt
rightstick.txt
# runtime output wherever it lands
crash_log.txt
game_log.txt
online_log.txt
*.zip
*.zip.[0-9][0-9][0-9]

# ---- tools: not tracked (kept on disk only)
port/tools/

# Session notes: kept local, never published
port/HANDOFF.md
temp_handoff.txt

# ---- Android build (port/android) ------------------------------------------
port/android/deps/
port/android/.gradle/
port/android/build/
port/android/app/build/
port/android/app/.cxx/
port/android/local.properties
